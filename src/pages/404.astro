---
import Base from '../layouts/Base.astro';
---

<Base title="ページが見つかりません — ビカク図鑑">
  <section class="notfound">
    <p class="icon">🦌</p>
    <h1>404 — ページが見つかりません</h1>
    <p class="msg">お探しの品種は移動したか、まだ掲載されていないようです。</p>
    <a href="/" class="home-btn">品種一覧へ戻る</a>
  </section>
</Base>

<style>
  .notfound {
    text-align: center;
    padding: 5rem 1rem;
  }
  .icon { font-size: 4rem; margin-bottom: 1rem; opacity: 0.5; }
  h1 {
    font-size: 1.4rem;
    color: var(--green-dark);
    margin-bottom: 0.8rem;
  }
  .msg { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 2rem; }
  .home-btn {
    display: inline-block;
    background: var(--green-dark);
    color: #fff;
    text-decoration: none;
    padding: 0.7rem 1.6rem;
    border-radius: 8px;
    font-size: 0.9rem;
    transition: background 0.2s;
  }
  .home-btn:hover { background: var(--green-mid); }
</style>
