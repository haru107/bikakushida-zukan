---
import Base from '../../layouts/Base.astro';

const guides = [
  {
    href: '/guide/itazuke/',
    img: '/guide/itazuke_hero.jpg',
    title: 'ビカクシダの板付け方法',
    desc: '必要な道具から6ステップの手順・失敗しやすいポイント・板付け後の管理まで。',
  },
  {
    href: '/guide/mizuyari/',
    img: '/guide/mizuyari_hero.jpg',
    title: '水やり【頻度・ドブ漬け・水切れサイン】',
    desc: '「乾いたらたっぷり」が基本。シャワーとドブ漬けのやり方、季節ごとの頻度、乾き具合の見分け方。',
  },
  {
    href: '/guide/fuyugoshi/',
    img: '/guide/fuyugoshi_hero.jpg',
    title: '冬越し【耐寒温度・置き場所・冬の水やり】',
    desc: '品種ごとの耐寒目安、取り込みタイミング、窓辺の落とし穴、冬の水やりの絞り方。',
  },
  {
    href: '/guide/kokabu/',
    img: '/guide/kokabu_hero.jpg',
    title: '子株の外し方と増やし方',
    desc: '外すタイミングの見極めから、ナイフでの切り分け、外した後の板付けと管理まで。',
  },
  {
    href: '/guide/houshi/',
    img: '/guide/houshi_hero.jpg',
    title: '胞子培養入門',
    desc: '胞子の採取・殺菌と播種・前葉体から幼苗までの経過とカビ対策。単頭種を増やす唯一の方法。',
  },
];
---

<Base
  title="育て方ガイド — ビカク図鑑"
  description="ビカクシダ（コウモリラン）の育て方ガイド。板付けの方法・水やり・冬越し・子株の増やし方・胞子培養を初心者向けに解説します。"
>
  <section class="intro">
    <p class="label">GROWING GUIDE</p>
    <h1>📖 育て方ガイド</h1>
    <p class="lead">ビカクシダ（コウモリラン）を育てるための実践ガイド全5本。品種選びは<a href="/">品種一覧</a>、品種ごとの個別の育て方は各品種ページをどうぞ。</p>
  </section>

  <div class="guide-list">
    {guides.map(g => (
      <a href={g.href} class="guide-card">
        <img class="guide-thumb" src={g.img} alt="" width="120" height="90" loading="lazy" />
        <div>
          <h2>{g.title}</h2>
          <p>{g.desc}</p>
        </div>
        <span class="arrow">→</span>
      </a>
    ))}
  </div>
</Base>

<style>
  .intro { margin-bottom: 2rem; }
  .label {
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .intro h1 { font-size: 1.7rem; color: var(--green-dark); margin-bottom: 0.6rem; }
  .lead { font-size: 0.9rem; line-height: 1.8; color: var(--text-muted); max-width: 720px; }
  .lead a { color: var(--green-mid); }

  .guide-list { display: flex; flex-direction: column; gap: 0.8rem; max-width: 760px; }
  .guide-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.9rem 1.2rem 0.9rem 0.9rem;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .guide-card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,0.08); }
  .guide-thumb {
    width: 120px;
    height: 90px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }
  .guide-card h2 { font-size: 1.02rem; color: var(--green-dark); margin-bottom: 0.25rem; }
  .guide-card p { font-size: 0.8rem; color: var(--text-muted); line-height: 1.6; }
  .arrow { margin-left: auto; color: var(--green-light); font-weight: 700; }

  @media (max-width: 540px) {
    .guide-thumb { width: 84px; height: 72px; }
  }
</style>
