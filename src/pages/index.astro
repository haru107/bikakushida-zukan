---
import Base from '../layouts/Base.astro';
import VarietyCard from '../components/VarietyCard.astro';
import varieties from '../data/varieties.json';

const groups  = [...new Set(varieties.map(v => v.group))];
const allTags = [...new Set(varieties.flatMap(v => v.tags))];
---

<Base title="ビカクシダ図鑑 — 原種一覧">

  <!-- ヒーロー -->
  <section class="hero">
    <div class="hero-content">
      <p class="hero-label">PLATYCERIUM DATABASE</p>
      <h1>🦌 ビカクシダ図鑑</h1>
      <p class="hero-desc">ビフルカツム・リドレイ・グランデなど、ビカクシダ（コウモリラン）の原種を詳しく解説。<br>現在 <strong id="total">{varieties.length}</strong> 種掲載中。今後さまざまな栽培品種も追加予定。</p>
    </div>
  </section>

  <!-- 検索・フィルターバー -->
  <section class="filter-bar">
    <div class="search-row">
      <input type="text" id="search" placeholder="🔍  種名・学名・特徴で検索…" autocomplete="off" />
      <select id="sort">
        <option value="default">並び順：デフォルト</option>
        <option value="name">名前順（あいうえお）</option>
        <option value="rarity-desc">希少度：高い順</option>
        <option value="rarity-asc">希少度：低い順</option>
        <option value="difficulty-desc">育てやすさ：簡単順</option>
      </select>
    </div>

    <div class="filter-row">
      <div class="filter-group">
        <span class="filter-label">産地</span>
        <div class="btn-group">
          <button class="filter-btn active" data-group="">すべて</button>
          {groups.map(g => (
            <button class="filter-btn" data-group={g}>{g.replace('系', '')}</button>
          ))}
        </div>
      </div>
    </div>

    <div class="filter-row">
      <div class="filter-group">
        <span class="filter-label">タグ</span>
        <div class="btn-group">
          <button class="tag-btn active" data-tag="">すべて</button>
          {allTags.map(t => (
            <button class="tag-btn" data-tag={t}>{t}</button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="list-header">
    <p class="count" id="count">{varieties.length}種 表示中</p>
  </div>

  <!-- カードグリッド -->
  <div class="grid" id="grid">
    {varieties.map((v, i) => (
      <div
        class="card-wrap"
        data-index={i}
        data-name={v.name}
        data-name-en={v.nameEn.toLowerCase()}
        data-sci={v.scientificName.toLowerCase()}
        data-desc={v.description}
        data-group={v.group}
        data-tags={v.tags.join(',')}
        data-rarity={v.rarity}
        data-difficulty={v.difficulty}
      >
        <VarietyCard variety={v} />
      </div>
    ))}
  </div>

  <!-- このサイトについて -->
  <section class="about" id="about">
    <h2>このサイトについて</h2>
    <p>ビカクシダ（コウモリラン）は世界に18種ほどの原種が知られ、そこから無数の栽培品種が生み出されてきました。情報はSNSや個人ブログに散在し、まとまった参照先がありませんでした。このサイトは「ここを見れば原種の特徴と育て方がわかる」場所を目指した品種データベースです。</p>
    <p>まずは原種から掲載し、ウィリンキー系の人気品種などは随時追加していく予定です。情報に誤りや追加したい品種があればお知らせください。</p>
  </section>
</Base>

<style>
  /* ヒーロー */
  .hero {
    background: linear-gradient(135deg, var(--green-dark) 0%, var(--green-mid) 100%);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    margin-bottom: 1.5rem;
    color: #fff;
  }
  .hero-label {
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .hero h1 { font-size: 2rem; font-weight: 700; margin-bottom: 0.6rem; }
  .hero-desc { color: rgba(255,255,255,0.75); font-size: 0.92rem; line-height: 1.7; }
  .hero-desc strong { color: var(--accent); }

  /* フィルターバー */
  .filter-bar {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.2rem 1.4rem;
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .search-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  #search {
    flex: 1;
    min-width: 200px;
    padding: 0.65rem 1rem;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    font-size: 0.92rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s;
  }
  #search:focus { border-color: var(--green-light); }

  #sort {
    padding: 0.65rem 1rem;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    font-size: 0.85rem;
    font-family: inherit;
    background: #fff;
    outline: none;
    cursor: pointer;
    color: var(--text);
  }

  .filter-row { display: flex; flex-direction: column; gap: 0.5rem; }
  .filter-group { display: flex; align-items: flex-start; gap: 0.75rem; flex-wrap: wrap; }
  .filter-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 700;
    min-width: 50px;
    padding-top: 0.3rem;
  }

  .btn-group { display: flex; flex-wrap: wrap; gap: 0.35rem; }

  .filter-btn, .tag-btn {
    font-size: 0.76rem;
    padding: 0.25rem 0.72rem;
    border-radius: 20px;
    border: 1.5px solid var(--border);
    background: #fff;
    cursor: pointer;
    font-family: inherit;
    color: var(--text-muted);
    transition: all 0.15s;
    white-space: nowrap;
  }
  .filter-btn:hover, .tag-btn:hover {
    border-color: var(--green-light);
    color: var(--green-mid);
    background: #f0f9f4;
  }
  .filter-btn.active {
    background: var(--green-dark);
    color: #fff;
    border-color: var(--green-dark);
  }
  .tag-btn.active {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  /* リストヘッダー */
  .list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .count { font-size: 0.82rem; color: var(--text-muted); }

  /* グリッド */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.2rem;
    margin-bottom: 3rem;
  }
  .card-wrap.hidden { display: none !important; }

  /* about */
  .about {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
    margin-top: 1rem;
  }
  .about h2 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--green-dark);
    margin-bottom: 0.75rem;
  }
  .about p {
    font-size: 0.87rem;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
</style>

<script>
  const searchEl  = document.getElementById('search')  as HTMLInputElement;
  const sortEl    = document.getElementById('sort')    as HTMLSelectElement;
  const countEl   = document.getElementById('count')!;
  const grid      = document.getElementById('grid')!;
  const cards     = () => Array.from(grid.querySelectorAll<HTMLElement>('.card-wrap'));
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const tagBtns    = document.querySelectorAll<HTMLButtonElement>('.tag-btn');

  let activeGroup = '';
  let activeTag   = '';

  function update() {
    const text  = searchEl.value.trim().toLowerCase();
    const order = sortEl.value;

    // フィルタリング
    let visible: HTMLElement[] = [];
    cards().forEach(card => {
      const name   = (card.dataset.name   ?? '').toLowerCase();
      const nameEn = card.dataset.nameEn  ?? '';
      const sci    = card.dataset.sci     ?? '';
      const desc   = (card.dataset.desc   ?? '').toLowerCase();
      const group  = card.dataset.group   ?? '';
      const tags   = card.dataset.tags    ?? '';

      const matchSearch = !text ||
        name.includes(text) || nameEn.includes(text) ||
        sci.includes(text)  || desc.includes(text);
      const matchGroup = !activeGroup || group === activeGroup;
      const matchTag   = !activeTag   || tags.split(',').includes(activeTag);

      if (matchSearch && matchGroup && matchTag) {
        card.classList.remove('hidden');
        visible.push(card);
      } else {
        card.classList.add('hidden');
      }
    });

    // ソート
    visible.sort((a, b) => {
      if (order === 'name') {
        return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', 'ja');
      }
      if (order === 'rarity-desc') {
        return Number(b.dataset.rarity) - Number(a.dataset.rarity);
      }
      if (order === 'rarity-asc') {
        return Number(a.dataset.rarity) - Number(b.dataset.rarity);
      }
      if (order === 'difficulty-desc') {
        return Number(b.dataset.difficulty) - Number(a.dataset.difficulty);
      }
      return Number(a.dataset.index) - Number(b.dataset.index);
    });

    // DOM 並び替え
    visible.forEach(card => grid.appendChild(card));

    countEl.textContent = `${visible.length}種 表示中`;
  }

  searchEl.addEventListener('input', update);
  sortEl.addEventListener('change', update);

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeGroup = btn.dataset.group ?? '';
      update();
    });
  });

  tagBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tagBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeTag = btn.dataset.tag ?? '';
      update();
    });
  });
</script>
