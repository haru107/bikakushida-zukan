---
export interface Props {
  variety: {
    id: string;
    name: string;
    nameEn: string;
    scientificName: string;
    group: string;
    type: string;
    size: string;
    shieldFrond: string;
    foliarFrond: string;
    rarity: number;
    difficulty: number;
    tags: string[];
    description: string;
    image: string | null;
  };
}
const { variety } = Astro.props;

const rarityStars = '★'.repeat(variety.rarity) + '☆'.repeat(5 - variety.rarity);
const difficultyLabel = ['', 'やや難しい', 'やや難しい', '普通', '比較的簡単', '簡単'][variety.difficulty];

// プレースホルダー用の色（グループ別）
const groupColors: Record<string, string> = {
  'オーストラリア系': '#356048',
  '東南アジア系':     '#2d5a4a',
  'アフリカ系':       '#4a5a2d',
  'マダガスカル系':   '#3a4a5a',
  '南米系':           '#5a4a2a',
};
const placeholderColor = groupColors[variety.group] ?? '#356048';
---

<a href={`/variety/${variety.id}`} class="card">
  <div class="card-image">
    {variety.image ? (
      <img
        src={variety.image}
        alt={variety.name}
        loading="lazy"
        onerror="this.parentElement.classList.add('no-img')"
      />
    ) : (
      <div class="placeholder" style={`background:${placeholderColor}`}>
        <span class="placeholder-name">{variety.name}</span>
        <span class="placeholder-icon">🦌</span>
      </div>
    )}
    <div class="type-badge">{variety.type}</div>
  </div>

  <div class="card-body">
    <div class="group-label">{variety.group}</div>
    <h2 class="name-ja">{variety.name}</h2>
    <p class="name-sci">{variety.scientificName}</p>
    <p class="description">{variety.description.slice(0, 60)}…</p>

    <div class="meta">
      <div class="meta-item">
        <span class="meta-label">希少度</span>
        <span class="stars rarity">{rarityStars}</span>
      </div>
      <div class="meta-item">
        <span class="meta-label">育てやすさ</span>
        <span class="ease">{difficultyLabel}</span>
      </div>
    </div>

    <div class="tags">
      {variety.tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--text);
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 28px rgba(0,0,0,0.12);
  }

  /* 画像エリア */
  .card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #1d3528;
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .card:hover .card-image img { transform: scale(1.05); }

  .placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .placeholder-name {
    color: rgba(255,255,255,0.6);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .placeholder-icon { font-size: 2.5rem; opacity: 0.4; }

  .type-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    font-size: 0.7rem;
    font-weight: 700;
    background: var(--accent);
    color: #fff;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
  }

  /* カード本体 */
  .card-body { padding: 1rem 1.1rem 1.1rem; }

  .group-label {
    font-size: 0.7rem;
    color: var(--green-light);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.25rem;
  }
  .name-ja {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--green-dark);
    margin-bottom: 0.1rem;
    line-height: 1.2;
  }
  .name-sci {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: 0.65rem;
  }
  .description {
    font-size: 0.82rem;
    line-height: 1.6;
    color: #555;
    margin-bottom: 0.75rem;
  }

  .meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
  }
  .meta-item { display: flex; align-items: center; gap: 0.3rem; }
  .meta-label { font-size: 0.68rem; color: var(--text-muted); }
  .stars { font-size: 0.82rem; letter-spacing: -1px; }
  .rarity { color: var(--accent); }
  .ease   { font-size: 0.75rem; color: var(--green-light); font-weight: 700; }

  .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .tag {
    font-size: 0.67rem;
    background: #eef5f0;
    color: var(--green-mid);
    padding: 0.18rem 0.5rem;
    border-radius: 20px;
    border: 1px solid #cce0d4;
  }
</style>
